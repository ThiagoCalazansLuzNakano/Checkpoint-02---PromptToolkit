import os
import time
from ollama import Client
from google.colab import userdata

# --- 1. CONFIGURAÇÃO DE AMBIENTE ---
try:
    os.environ['OLLAMA_API_KEY'] = userdata.get('OLLAMA_API_KEY')
except Exception as e:
    print(f"⚠️ Erro ao carregar segredos: {e}")

API_KEY = os.getenv('OLLAMA_API_KEY')
MODEL_NAME = "gpt-oss:120b" 

client = Client(
    host="https://ollama.com",
    headers={'Authorization': f'Bearer {API_KEY}'}
)

# --- 2. FUNÇÃO DE CHAMADA AO MODELO ---
def chamar_llm(prompt, temperature):
    try:
        response = client.chat(
            model=MODEL_NAME,
            messages=[{"role": "user", "content": prompt}],
            options={"temperature": temperature, "num_predict": 300},
            stream=False
        )
        
        return {
            "texto": response['message']['content'].strip(),
            "tokens": response.get('prompt_eval_count', 0) + response.get('eval_count', 0)
        }
    except Exception as e:
        return {"texto": f"Erro: {e}", "tokens": 0}

# --- 3. TOOLKIT COM MATRIZ DE TEMPERATURA ---
def executar_matriz_prompting(tarefa):
    print(f"🚀 Iniciando Matriz de Teste para: {tarefa}\n")
    
    tecnicas = {
        "Zero-Shot": f"Tarefa: {tarefa}",
        "Few-Shot": f"Exemplo: Analisar custos -> Relatório financeiro. Tarefa: {tarefa}",
        "Chain of Thought": f"Tarefa: {tarefa}. Pense passo a passo.",
        "Persona": f"Aja como um Consultor Sênior. Resolva: {tarefa}"
    }
    
    # Temperaturas 
    temperaturas = [0.1, 0.7, 1.5]
    matriz_resultados = {}

    for nome_tecnica, prompt_texto in tecnicas.items():
        print(f"📊 Testando técnica: {nome_tecnica}")
        matriz_resultados[nome_tecnica] = {}
        
        for temp in temperaturas:
            print(f"   🌡️ Temp {temp}...")
            res = chamar_llm(prompt_texto, temperature=temp)
            matriz_resultados[nome_tecnica][temp] = res
            
    return matriz_resultados

# --- 4. EXECUÇÃO E EXIBIÇÃO ---
TAREFA_TESTE = "Plano de expansão para uma pequena manufatura de móveis sustentáveis"
resultados_finais = executar_matriz_prompting(TAREFA_TESTE)

print("\n" + "="*70)
print("📈 RESULTADOS DA MATRIZ (TÉCNICA vs TEMPERATURA)")
print("="*70)

for tecnica, temps in resultados_finais.items():
    print(f"\n▶️ TÉCNICA: {tecnica.upper()}")
    print("-" * 30)
    
    for t_valor, dados in temps.items():
        label = "CONSERVADOR" if t_valor == 0.1 else "EQUILIBRADO" if t_valor == 0.7 else "CRIATIVO/CAÓTICO"
        print(f"[{t_valor} - {label}] | 📊 Tokens: {dados['tokens']}")
        print(f"RESPOSTA: {dados['texto'][:250]}...") # Mostra o resumo
        print("." * 15)

# --- 5. RECOMENDAÇÃO ---
print("\n🤖 IA ANALISANDO A MELHOR COMBINAÇÃO...")

resumo_juiz = ""
for t_nome, t_dados in resultados_finais.items():
    resumo_juiz += f"\n- {t_nome} (Temp 0.7): {t_dados[0.7]['texto'][:300]}"

prompt_juiz = f"""
Com base nas variações de técnica e temperatura abaixo, 
recomende qual abordagem é a mais profissional para a tarefa: '{TAREFA_TESTE}'.
{resumo_juiz}
"""

veredito = chamar_llm(prompt_juiz, temperature=0.2)

print("\n" + "🏆" * 15)
print("RECOMENDAÇÃO FINAL:")
print(veredito['texto'])
print("🏆" * 15)
